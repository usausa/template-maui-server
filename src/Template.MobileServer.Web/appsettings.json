{
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://*:9090",
        "Protocols": "Http2"
      },
      "Otel": {
        "Url": "http://*:4317",
        "Protocols": "Http2"
      }
    }
  },

  "ConnectionStrings": {
    "Default": "Data Source=data.db;Cache=Shared;Pooling=True"
  },

  "FeatureManagement": {
    "CustomOption": true
  },

  "Compression": {
    "Response": true,
    "Request": true
  },

  "Csp": {
    "ReportOnly": false
  },

  "Log": {
    "HttpLog": false,
    "HttpDump": false,
    "HttpDumpLimit": 4096,
    "W3CLog": {
      "Enable": false,
      "Directory": "../log",
      "FileName": "access-",
      "RetainedFileCount": 4
    }
  },

  "Profiler": {
    "SqlLog": {
      "Enable": false,
      "OutputParameter": true,
      "ElapsedThresholdMilliseconds": 0
    },
    "SqlTelemetry": {
      "Enable": false
    }
  },

  "Telemetry": {
    "LongExecutionThreshold": 5000
  },

  "Prometheus": {
    "Uri": "http://0.0.0.0:9464"
  },

  "Jwt": {
    "Issuer": "TemplateMobileServer",
    "Audience": "TemplateMobileServer",
    "SecretKey": "template-mobile-server-secret-key-0123456789",
    "ExpireMinutes": 1440
  },

  "Storage": {
    "Root": "storage"
  },

  "ServerStatus": {
    "Interval": 1000
  },

  "Notification": {
    "Enable": false,
    "IntervalSeconds": 60
  },

  "TelemetryReceiver": {
    "MaxReceiveMessageSize": 16777216
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/Template.MobileServer.Web_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
