<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <PackageReference Include="MiniDataProfiler" Version="2.0.0" />
    <PackageReference Include="MiniDataProfiler.Listener.Logging" Version="2.0.0" />
    <PackageReference Include="MiniDataProfiler.Listener.OpenTelemetry" Version="2.0.0" />
    <PackageReference Include="MudBlazor" Version="9.13.0" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.8.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.HttpListener" Version="1.21.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Usa.Smart.Blazor" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Data.Accessor.Extensions.DependencyInjection" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.Mapper" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Template.MobileServer.Core\Template.MobileServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Handlers\Protos\**\*.proto" GrpcServices="Server" />
    <Protobuf Include="Telemetry\Protos\*.proto" ProtoRoot="Telemetry\Protos" GrpcServices="None" />
    <Protobuf Update="Telemetry\Protos\*_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
