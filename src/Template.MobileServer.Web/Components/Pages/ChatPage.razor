@page "/chat"
@inherits AppComponentBase

<PageTitle>Chat</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Chat</MudText>

<MudPaper id="chat-messages" Outlined="true" Class="chat-messages pa-4 mb-4">
    <MudStack Spacing="2">
        <ListItem Items="entries" Context="entry">
            <ItemTemplate>
                <div>
                    <MudText Typo="Typo.caption">@entry.User - @FormatTimestamp(entry.Timestamp.ToLocalTime().DateTime)</MudText>
                    <MudText>@entry.Text</MudText>
                </div>
            </ItemTemplate>
        </ListItem>
    </MudStack>
</MudPaper>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="chat-input">
    <MudTextField @bind-Value="userName"
                  Label="名前"
                  Class="chat-user" />
    <MudTextField @bind-Value="input"
                  Label="メッセージ"
                  Immediate="true"
                  OnKeyDown="OnInputKeyDown" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="Send">送信</MudButton>
</MudStack>
