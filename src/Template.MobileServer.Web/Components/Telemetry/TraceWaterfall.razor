<div class="waterfall">
    <div class="waterfall-row waterfall-head">
        <div class="waterfall-name">スパン</div>
        <svg class="waterfall-timeline">
            <ListItem Items="ticks" Context="tick">
                <ItemTemplate>
                    <line class="waterfall-tick" x1="@tick.X" y1="6" x2="@tick.X" y2="23" />
                    <text class="waterfall-tick-label" x="@tick.X" y="19" dx="3">@tick.Label</text>
                </ItemTemplate>
            </ListItem>
        </svg>
        <div class="waterfall-duration">所要時間</div>
    </div>
    <ListItem Items="Model.VisibleRows" Context="row">
        <ItemTemplate>
            <div class="@RowClass(row)" @onclick="() => SelectAsync(row)">
                <div class="waterfall-name">
                    <svg class="waterfall-indent" width="@Indent(row)" height="1"></svg>
                    <Condition Value="row.HasChildren">
                        <ChildContent>
                            <button type="button" class="waterfall-toggle" @onclick="() => Toggle(row)" @onclick:stopPropagation="true">
                                <MudIcon Icon="@ToggleIcon(row)" Size="Size.Small" />
                            </button>
                        </ChildContent>
                        <ElseContent>
                            <span class="waterfall-toggle"></span>
                        </ElseContent>
                    </Condition>
                    <span class="waterfall-span-name" title="@row.Span.Name">@row.Span.Name</span>
                </div>
                <svg class="waterfall-timeline">
                    <rect class="@BarClass(row)" x="@BarX(row)" y="8" width="@BarWidth(row)" height="12" rx="2" />
                    <rect class="@BarClass(row)" x="@BarX(row)" y="8" width="2" height="12" rx="1" />
                    <ListItem Items="row.Events" Context="item">
                        <ItemTemplate>
                            <rect class="@EventClass(item)" x="@EventX(item)" y="5" width="@EventWidth(item)" height="18"><title>@item.Name</title></rect>
                        </ItemTemplate>
                    </ListItem>
                </svg>
                <div class="waterfall-duration">@FormatDuration(row.Duration)</div>
            </div>
        </ItemTemplate>
    </ListItem>
</div>
