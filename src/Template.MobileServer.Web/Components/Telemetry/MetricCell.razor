<span class="metric-cell" title="@title">
    <Condition Value="showIcon">
        <MudIcon Icon="@icon" Color="@color" Size="Size.Small" />
    </Condition>
    <Condition Value="showMeter">
        <span class="meter-track"><span class="@fillClass" style="@fillStyle"></span></span>
    </Condition>
    <span>@text</span>
</span>
