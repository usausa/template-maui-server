<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="model">
            <MudTextField @bind-Value="model.DeviceId"
                          For="@(() => model.DeviceId)"
                          Validation="@Validator.ValidateValue"
                          Label="端末 ID"
                          HelperText="英数字・'-'・'_'"
                          MaxLength="@Length.DeviceId"
                          Disabled="IsEdit"
                          Immediate="true" />
            <MudTextField @bind-Value="model.Name"
                          For="@(() => model.Name)"
                          Validation="@Validator.ValidateValue"
                          Label="名前"
                          MaxLength="@Length.Name"
                          Immediate="true"
                          Class="mt-4" />
            <MudTextField @bind-Value="model.GroupName"
                          For="@(() => model.GroupName)"
                          Validation="@Validator.ValidateValue"
                          Label="グループ"
                          MaxLength="@Length.Name"
                          Immediate="true"
                          Class="mt-4" />
            <MudTextField @bind-Value="model.Note"
                          For="@(() => model.Note)"
                          Validation="@Validator.ValidateValue"
                          Label="メモ"
                          MaxLength="@Length.Note"
                          Lines="3"
                          Immediate="true"
                          Class="mt-4" />
            <MudSwitch T="bool"
                       @bind-Value="model.IsEnabled"
                       Label="有効 (無効の端末のテレメトリは保存しない)"
                       Color="Color.Primary"
                       Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnOkClick">OK</MudButton>
        <MudButton Color="Color.Default" OnClick="OnCancelClick">CANCEL</MudButton>
    </DialogActions>
</MudDialog>
