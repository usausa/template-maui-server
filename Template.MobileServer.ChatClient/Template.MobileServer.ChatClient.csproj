<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="2.16.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="2.8.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="2.15.0" />
    <PackageReference Include="Usa.Smart.Windows" Version="2.26.0" />
    <PackageReference Include="Usa.Smart.Windows.Extensions" Version="2.26.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- protoはサーバー側の定義を共有する -->
    <Protobuf Include="..\Template.MobileServer.Web\Protos\chat.proto" GrpcServices="Client" Link="Protos\chat.proto" />
  </ItemGroup>

</Project>
