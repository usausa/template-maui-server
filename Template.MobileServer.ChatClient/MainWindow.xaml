<Window x:Class="Template.MobileServer.ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Template.MobileServer.ChatClient"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:ClassModifier="internal"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
        Title="MobileServer Chat"
        Width="640"
        Height="640">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  接続設定  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" VerticalAlignment="Center" Text="Server" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" IsEnabled="{Binding CanConnect}" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,4,4" VerticalAlignment="Center" Text="gRPC" />
            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,8,4" IsEnabled="{Binding CanConnect}" Text="{Binding GrpcUrl, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,0,4,4" VerticalAlignment="Center" Text="User" />
            <TextBox Grid.Row="0" Grid.Column="5" Margin="0,0,0,4" IsEnabled="{Binding CanConnect}" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal">
                <Button Width="96" Margin="0,0,8,0" Command="{Binding ConnectCommand}" Content="接続" IsEnabled="{Binding CanConnect}" />
                <Button Width="96" Command="{Binding DisconnectCommand}" Content="切断" IsEnabled="{Binding CanDisconnect}" />
            </StackPanel>
        </Grid>

        <!--  状態インジケータ  -->
        <StackPanel Grid.Row="1" Margin="0,8,0,8" Orientation="Horizontal">
            <Ellipse Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="Gray" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Connected">
                                <Setter Property="Fill" Value="LimeGreen" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Connecting">
                                <Setter Property="Fill" Value="Orange" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                                <Setter Property="Fill" Value="Orange" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock VerticalAlignment="Center" Text="{Binding State}" />
        </StackPanel>

        <!--  メッセージ一覧  -->
        <ListBox x:Name="MessageList"
                 Grid.Row="2"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Messages}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock FontSize="11" Foreground="Gray">
                            <Run Text="{Binding User, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Timestamp, Mode=OneWay, StringFormat=yyyy/MM/dd HH:mm:ss}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  入力  -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="0,0,8,0"
                     IsEnabled="{Binding CanDisconnect}"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Width="96" Command="{Binding SendCommand}" Content="送信" IsEnabled="{Binding CanDisconnect}" />
        </Grid>
    </Grid>
</Window>
